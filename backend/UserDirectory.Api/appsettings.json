{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/app.db"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Auth0": {
    "Domain": "",
    "Audience": ""
  },
  "AllowedCorsOrigins": [
    "http://localhost:5173",
    "http://localhost:5174"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
